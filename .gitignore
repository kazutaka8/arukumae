__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# ---- Claude Code・Codex の手元の記録（launch.json と codex-review.json は入れる） ----
.claude/settings.local.json
.claude/*.local.json
.claude/*.local.md
.claude/scratch/
.claude/worktrees/
CLAUDE.local.md
AGENTS.local.md
*.local.md
.codex/
.codex-review/
.cursor/
.aider*

# ---- ログ・一時ファイル ----
*.log
# 試しの記録（experiments/*/out/）のログは残す。鍵は出していない（run.py はキーチェーンから読む）
!experiments/*/out/*.log
npm-debug.log*
yarn-error.log*
*.tmp
*.bak
*.orig
*.swp
*~
tmp/
temp/

